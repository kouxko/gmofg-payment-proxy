    "rules": [
      {
        "existing_rule_id": "00000000-0000-0000-0000-000000000020",
        "name": "Retained HTTP request rule",
        "description": "Canonical retained-selector fixture",
        "enabled": true,
        "priority": 10,
        "listener_alias": "http-entry",
        "stage": "proxy_to_upstream",
        "conditions": [
          {
            "Field": {
              "field": "TerminalIp",
              "operator": {
                "Equals": "192.0.2.10"
              }
            }
          },
          {
            "Field": {
              "field": {
                "JsonPath": "$.amount"
              },
              "operator": {
                "Regex": "^[0-9]+$"
              }
            }
          },
          {
            "NthHit": 1
          }
        ],
        "actions": [
          "Pause",
          {
            "SetJsonField": {
              "path": "$.amount",
              "value": 1000
            }
          },
          {
            "ReplaceBodyText": "replacement"
          },
          {
            "SetHeader": {

diff --git a/examples/protocol-packages/gmofg_cps/src/codec.rs b/examples/protocol-packages/gmofg_cps/src/codec.rs
new file mode 100644
index 00000000..b24af451
--- /dev/null
+++ b/examples/protocol-packages/gmofg_cps/src/codec.rs
@@ -0,0 +1,72 @@
+use serde_json::Value;
+
+pub(crate) fn decode(input: &str) -> Result<String, String> {
+    // D6: a non-JSON business body must reach Finalize unchanged as a text Document.
+    let document =
+        serde_json::from_str::<Value>(input).unwrap_or_else(|_| Value::String(input.to_owned()));
+    serde_json::to_string(&document).map_err(|error| error.to_string())
+}
+
+pub(crate) fn encode(original_input: &str, document_json: &str) -> Result<String, String> {
+    let document: Value = serde_json::from_str(document_json)
+        .map_err(|error| format!("invalid CPS Document JSON: {error}"))?;
+    match serde_json::from_str::<Value>(original_input) {
+        Ok(original) if json_equivalent(&original, &document) => Ok(original_input.to_owned()),
+        Ok(_) => serde_json::to_string_pretty(&document).map_err(|error| error.to_string()),
+        Err(_) => match document {
+            Value::String(text) => Ok(text),
+            value => serde_json::to_string_pretty(&value).map_err(|error| error.to_string()),
+        },
+    }
+}
+
+// Match the existing json_pretty codec: Host Document stores numbers as f64.
+// Compare its numeric representation so a no-op does not rewrite the wire body.
+fn json_equivalent(left: &Value, right: &Value) -> bool {
+    match (left, right) {
+        (Value::Number(left), Value::Number(right)) => match (left.as_f64(), right.as_f64()) {
+            (Some(left), Some(right)) => left == right,
+            _ => left == right,
+        },
+        (Value::Array(left), Value::Array(right)) => {
+            left.len() == right.len()
+                && left
+                    .iter()
+                    .zip(right)
+                    .all(|(left, right)| json_equivalent(left, right))
+        }
+        (Value::Object(left), Value::Object(right)) => {
+            left.len() == right.len()
+                && left.iter().all(|(key, left)| {
+                    right
+                        .get(key)
+                        .is_some_and(|right| json_equivalent(left, right))
+                })
+        }
+        _ => left == right,
+    }
+}
+
+pub(crate) fn display(document_json: &str) -> Result<String, String> {
+    let document: Value = serde_json::from_str(document_json)
+        .map_err(|error| format!("invalid CPS Display Document: {error}"))?;
+    let text = match &document {
+        Value::String(text) => text.clone(),
+        _ => serde_json::to_string_pretty(&document).map_err(|error| error.to_string())?,
+    };
+    let mut html = String::from(
+        "<section><h3>GMOFG CPS</h3><pre style=\"white-space:pre-wrap;overflow-wrap:anywhere\">",
+    );
+    for ch in text.chars() {
+        match ch {
+            '&' => html.push_str("&amp;"),
+            '<' => html.push_str("&lt;"),
+            '>' => html.push_str("&gt;"),
+            '"' => html.push_str("&quot;"),
+            '\'' => html.push_str("&#39;"),
+            _ => html.push(ch),
+        }
+    }
+    html.push_str("</pre></section>");
+    Ok(html)
+}
diff --git a/examples/protocol-packages/gmofg_cps/src/finalize.rs b/examples/protocol-packages/gmofg_cps/src/finalize.rs
new file mode 100644
index 00000000..fdbbb0dc
--- /dev/null
+++ b/examples/protocol-packages/gmofg_cps/src/finalize.rs
@@ -0,0 +1,65 @@
+use serde_json::Value;
+
+use crate::{route, signing};
+
+pub(crate) fn downstream(input: &str) -> Result<String, String> {
+    let mut http: Value =
+        serde_json::from_str(input).map_err(|error| format!("invalid HTTP JSON: {error}"))?;
+    validate_http(&http)?;
+    let method = http["method"].as_str().expect("validated method");
+    if method != "POST"
+        || !http["code"]
+            .as_u64()
+            .is_some_and(|code| (200..300).contains(&code))
+    {
+        return Ok(input.to_owned());
+    }
+    let url = http["url"].as_str().expect("validated URL");
+    let Some((operation, token)) = route::operation_and_token(url) else {
+        return Ok(input.to_owned());
+    };
+    let body_text = http["body"].as_str().expect("validated body");
+    let Ok(mut body) = serde_json::from_str::<Value>(body_text) else {
+        return Ok(input.to_owned());
+    };
+    let Some(previous) = body.pointer("/data/sign").and_then(signing::java_string) else {
+        return Ok(input.to_owned());
+    };
+    if previous.is_empty() {
+        return Ok(input.to_owned());
+    }
+    let Some(sign) = signing::signature(&body, operation, &token) else {
+        return Ok(input.to_owned());
+    };
+    if sign == previous {
+        return Ok(input.to_owned());
+    }
+    // All applicability checks finish before mutating the candidate response.
+    body["data"]["sign"] = Value::String(sign);
+    http["body"] = Value::String(serde_json::to_string(&body).map_err(|error| error.to_string())?);
+    serde_json::to_string(&http).map_err(|error| error.to_string())
+}
+
+fn validate_http(value: &Value) -> Result<(), String> {
+    let Some(fields) = value.as_object() else {
+        return Err("Finalize expects a five-field HTTP object".to_owned());
+    };
+    if fields.len() != 5
+        || !["url", "method", "code", "header", "body"]
+            .iter()
+            .all(|name| fields.contains_key(*name))
+        || !["url", "method", "body"]
+            .iter()
+            .all(|name| value[*name].is_string())
+        || !(value["code"].is_null()
+            || value["code"]
+                .as_u64()
+                .is_some_and(|code| u16::try_from(code).is_ok()))
+        || !value["header"]
+            .as_object()
+            .is_some_and(|header| header.values().all(Value::is_string))
+    {
+        return Err("Finalize requires url/method/body strings, code number or null, and string-valued header object".to_owned());
+    }
+    Ok(())
+}

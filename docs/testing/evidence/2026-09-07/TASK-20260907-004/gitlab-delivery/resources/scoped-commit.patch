+#![cfg_attr(not(any(test, target_arch = "wasm32")), allow(dead_code))]
+
+mod codec;
+mod finalize;
+mod route;
+mod signing;
+
+wit_bindgen::generate!({
+    path: "../../../src-tauri/crates/package-runtime/wit",
+    world: "http-package-downstream-finalize",
+});
+
+const _: &str =
+    include_str!("../../../../src-tauri/crates/package-runtime/wit/protocol-package.wit");
+
+struct Cps;
+
+impl Guest for Cps {
+    fn upstream_decode(input: String) -> Result<String, PackageError> {
+        codec::decode(&input).map_err(package_error("BODY_DECODE_FAILED"))
+    }
+
+    fn downstream_decode(input: String) -> Result<String, PackageError> {
+        codec::decode(&input).map_err(package_error("BODY_DECODE_FAILED"))
+    }
+
+    fn upstream_encode(
+        original_input: String,
+        document_json: String,
+    ) -> Result<String, PackageError> {
+        codec::encode(&original_input, &document_json).map_err(package_error("BODY_ENCODE_FAILED"))
+    }
+
+    fn downstream_encode(
+        original_input: String,
+        document_json: String,
+    ) -> Result<String, PackageError> {
+        codec::encode(&original_input, &document_json).map_err(package_error("BODY_ENCODE_FAILED"))
+    }
+
+    fn upstream_display(document_json: String) -> Result<String, PackageError> {
+        codec::display(&document_json).map_err(package_error("DISPLAY_FAILED"))
+    }
+
+    fn downstream_display(document_json: String) -> Result<String, PackageError> {
+        codec::display(&document_json).map_err(package_error("DISPLAY_FAILED"))
+    }
+
+    fn downstream_finalize(http_json: String) -> Result<String, PackageError> {
+        finalize::downstream(&http_json).map_err(package_error("CPS_FINALIZE_INVALID_INPUT"))
+    }
+}
+
+fn package_error(code: &'static str) -> impl FnOnce(String) -> PackageError {
+    move |message| PackageError {
+        code: code.to_owned(),
+        message,
+    }
+}
+
+export!(Cps);
+
+#[cfg(test)]
+mod tests;
diff --git a/examples/protocol-packages/gmofg_cps/src/route.rs b/examples/protocol-packages/gmofg_cps/src/route.rs
new file mode 100644
index 00000000..05b5689f
--- /dev/null
+++ b/examples/protocol-packages/gmofg_cps/src/route.rs
@@ -0,0 +1,73 @@
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Operation {
+    Pay,
+    Confirm,
+    Refund,
+    Reverse,
+}
+
+const ROUTES: &[(Operation, &str)] = &[
+    (Operation::Pay, "stub-products-pointPay"),
+    (Operation::Pay, "products-pointPay"),
+    (Operation::Pay, "stubPay"),
+    (Operation::Pay, "pay"),
+    (Operation::Confirm, "stub-products-pointConfirm"),
+    (Operation::Confirm, "products-pointConfirm"),
+    (Operation::Confirm, "stubConfirm"),
+    (Operation::Confirm, "confirm"),
+    (Operation::Refund, "stub-products-refund"),
+    (Operation::Refund, "products-refund"),
+    (Operation::Refund, "stubRefund"),
+    (Operation::Refund, "refund"),
+    (Operation::Reverse, "stub-products-reverse"),
+    (Operation::Reverse, "products-reverse"),
+    (Operation::Reverse, "stubReverse"),
+    (Operation::Reverse, "reverse"),
+];
+
+pub(crate) fn operation_and_token(url: &str) -> Option<(Operation, String)> {
+    let url = url.split(['?', '#']).next()?;
+    let target = if let Some(rest) = url
+        .strip_prefix("http://")
+        .or_else(|| url.strip_prefix("https://"))
+    {
+        let (_, path) = rest.split_once('/')?;
+        format!("/{path}")
+    } else if url.starts_with('/') {
+        url.to_owned()
+    } else {
+        return None;
+    };
+    let path = target.as_str();
+    for &(operation, endpoint) in ROUTES {
+        let version = match operation {
+            Operation::Pay | Operation::Confirm => "version=1.0/",
+            Operation::Refund | Operation::Reverse => "",
+        };
+        let marker = format!("/gateway/{endpoint}/{version}B01/1/0/");
+        // The configured CPS host can include a base path; the suffix is source-defined.
+        if let Some((_, token)) = path.rsplit_once(&marker) {
+            if token.is_empty() || token.contains('/') {
+                return None;
+            }
+            return percent_decode(token).map(|token| (operation, token));
+        }
+    }
+    None
+}
+
+fn percent_decode(value: &str) -> Option<String> {
+    let mut source = value.as_bytes().iter().copied();
+    let mut bytes = Vec::with_capacity(value.len());
+    while let Some(byte) = source.next() {
+        if byte == b'%' {
+            let high = char::from(source.next()?).to_digit(16)?;
+            let low = char::from(source.next()?).to_digit(16)?;
+            bytes.push(u8::try_from(high * 16 + low).ok()?);
+        } else {
+            // '+' is literal in a URL path, not a form-encoded space.
+            bytes.push(byte);
+        }
+    }
+    String::from_utf8(bytes).ok()
+}
diff --git a/examples/protocol-packages/gmofg_cps/src/signing.rs b/examples/protocol-packages/gmofg_cps/src/signing.rs
new file mode 100644
index 00000000..ae06c4f6
--- /dev/null
+++ b/examples/protocol-packages/gmofg_cps/src/signing.rs
@@ -0,0 +1,107 @@
+use std::collections::BTreeMap;
+
+use md5::{Digest, Md5};
+use serde_json::{Map, Value};
+
+use crate::route::Operation;
+
+const BASE_RESULT: &[&str] = &["orderDetailId", "orderId", "transTime", "transStatus"];
+
+pub(crate) fn signature(body: &Value, operation: Operation, token: &str) -> Option<String> {
+    let text = canonical(body, operation, token)?;
+    Some(format!("{:X}", Md5::digest(text.as_bytes())))
+}
+
+pub(crate) fn canonical(body: &Value, operation: Operation, token: &str) -> Option<String> {
+    let root = body.as_object()?;
+    let mut fields = BTreeMap::new();
+    if let Some(data) = present(root, "data") {
+        let data = data.as_object()?;
+        let mut values = strings(data, &["errorCode", "errorInfo", "subErrorCode"])?;
+        if let Some(result) = present(data, "result") {
+            values.insert("result", result_pairs(result, operation)?);
+        }
+        fields.insert("data", format!("{{{}}}", pairs(values)));
+    }
+    if let Some(meta) = present(root, "meta") {
+        let values = strings(meta.as_object()?, &["code", "message"])?;
+        fields.insert("meta", format!("{{{}}}", pairs(values)));
+    }
+    // The App strips ASCII spaces from field values, but never from the token.
+    Some(format!("{{{}&key=B2B{token}}}", pairs(fields)))
+}
+
+fn result_pairs(result: &Value, operation: Operation) -> Option<String> {
+    let result = result.as_object()?;
+    let mut fields = strings(result, BASE_RESULT)?;
+    let (text, integers): (&[&str], &[&str]) = match operation {
+        Operation::Pay => (
+            &["currencyCode", "payType", "extendedInfo"],
+            &["amount", "amountRmb"],
+        ),
+        Operation::Confirm => (&["payType", "payCheckDate"], &[]),
+        Operation::Refund => (&["currencyCode"], &["refundAmount"]),
+        Operation::Reverse => (&["currencyCode"], &["amount"]),
+    };
+    fields.extend(strings(result, text)?);
+    for &name in integers {
+        if let Some(value) = present(result, name) {
+            let value = java_int(value)?;
+            if value != 0 {
+                fields.insert(name, value.to_string());
+            }
+        }
+    }
+    Some(format!("{{{}}}", pairs(fields)))
+}
+
+fn present<'a>(object: &'a Map<String, Value>, name: &str) -> Option<&'a Value> {
+    object.get(name).filter(|value| !value.is_null())
+}
+
+fn strings<'a>(
+    object: &Map<String, Value>,
+    names: &'a [&str],
+) -> Option<BTreeMap<&'a str, String>> {
+    let mut fields = BTreeMap::new();
+    for &name in names {
+        if let Some(value) = present(object, name) {
+            fields.insert(name, java_string(value)?);
+        }
+    }
+    Some(fields)
+}
+
+pub(crate) fn java_string(value: &Value) -> Option<String> {
+    match value {
+        Value::String(text) => Some(text.clone()),
+        Value::Number(value) => Some(value.to_string()),
+        Value::Bool(value) => Some(value.to_string()),
+        _ => None,
+    }
+}
+
+fn java_int(value: &Value) -> Option<i32> {
+    let text = match value {
+        Value::String(text) => text.clone(),
+        Value::Number(value) => value.to_string(),
+        _ => return None,
+    };
+    if let Ok(number) = text.parse::<i32>() {
+        return Some(number);
+    }
+    // Gson JsonReader.nextInt also accepts exactly integral decimal/scientific text.
+    let number: f64 = text.trim_matches(|ch| ch <= '\u{0020}').parse().ok()?;
+    if !number.is_finite() || number.fract() != 0.0 {
+        return None;
+    }
+    format!("{number:.0}").parse().ok()
+}
+
+fn pairs(fields: BTreeMap<&str, String>) -> String {
+    fields
+        .into_iter()
+        .map(|(name, value)| format!("{name}={}", value.replace(' ', "")))
+        .collect::<Vec<_>>()
+        .join("&")
+}
diff --git a/examples/protocol-packages/gmofg_cps/src/tests.rs b/examples/protocol-packages/gmofg_cps/src/tests.rs
new file mode 100644
index 00000000..83d34f52
--- /dev/null
+++ b/examples/protocol-packages/gmofg_cps/src/tests.rs
@@ -0,0 +1,267 @@
+use serde_json::{Value, json};
+
+use super::{Cps, Guest, codec, finalize, route, signing};
+use route::Operation;
+
+#[test]
+fn signatures_match_original_java_oracle() {
+    let cases: Vec<Value> =
+        serde_json::from_str(include_str!("../tests/fixtures/java-signatures.json")).unwrap();
+    for case in cases {
+        let operation = match case["operation"].as_str().unwrap() {
+            "pay" => Operation::Pay,
+            "confirm" => Operation::Confirm,
+            "refund" => Operation::Refund,
+            "reverse" => Operation::Reverse,
+            other => panic!("unknown operation {other}"),
+        };
+        let body: Value = serde_json::from_str(case["body"].as_str().unwrap()).unwrap();
+        let token = case["token"].as_str().unwrap();
+        let canonical = signing::canonical(&body, operation, token);
+        let sign = signing::signature(&body, operation, token);
+        if case["expect_error"] == true {
+            assert!(canonical.is_none(), "{}", case["id"]);
+            assert!(sign.is_none(), "{}", case["id"]);
+        } else {
+            assert_eq!(
+                canonical.as_deref(),
+                case["canonical"].as_str(),
+                "{}",
+                case["id"]
+            );
+            assert_eq!(sign.as_deref(), case["sign"].as_str(), "{}", case["id"]);
+        }
+    }
+}
+
+fn response() -> Value {
+    json!({
+        "meta": {"code":"00", "message":"成功 OK"},
+        "data": {"sign":"OLD", "errorInfo":"", "result": {
+            "orderId":"order 1", "orderDetailId":"detail1", "transStatus":"SUCCESS",
+            "transTime":"20260907120000", "currencyCode":"JPY", "amount":100,
+            "amountRmb":0, "payType":"99", "extendedInfo":"unchanged"
+        }},
+        "extension":{"keep":[1,true,null]}
+    })
+}
+
+fn envelope(body: &str) -> Value {
+    json!({
+        "url":"https://cps.example/gateway/products-pointPay/version=1.0/B01/1/0/MERCHANT%20%20TERMINAL%20%20TOKEN",
+        "method":"POST", "code":200,
+        "header":{"Content-Type":"application/json;charset=UTF-8","X-Keep":"yes"},
+        "body":body
+    })
+}
+
+#[test]
+fn downstream_decode_display_encode_preserves_or_edits_complete_json() {
+    let original = format!("  {}\r\n", response());
+    let document = Cps::downstream_decode(original.clone()).unwrap();
+    assert_eq!(
+        serde_json::from_str::<Value>(&document).unwrap(),
+        response()
+    );
+    assert_eq!(
+        Cps::downstream_encode(original.clone(), document.clone()).unwrap(),
+        original
+    );
+    let display = Cps::downstream_display(document.clone()).unwrap();
+    for field in [
+        "meta",
+        "data",
+        "result",
+        "orderId",
+        "amount",
+        "sign",
+        "extension",
+    ] {
+        assert!(display.contains(field), "missing {field}");
+    }
+    let mut changed: Value = serde_json::from_str(&document).unwrap();
+    changed["data"]["result"]["amount"] = json!(250);
+    let encoded = Cps::downstream_encode(original, changed.to_string()).unwrap();
+    assert_eq!(serde_json::from_str::<Value>(&encoded).unwrap(), changed);
+    assert_eq!(
+        changed["data"]["sign"], "OLD",
+        "Encode does not sign before Finalize"
+    );
+}
+
+#[test]
+fn finalize_changes_only_data_sign_and_is_idempotent() {
+    let before_body = response();
+    let before = envelope(&before_body.to_string());
+    let output = finalize::downstream(&before.to_string()).unwrap();
+    let after: Value = serde_json::from_str(&output).unwrap();
+    for field in ["url", "method", "code", "header"] {
+        assert_eq!(after[field], before[field]);
+    }
+    let mut after_body: Value = serde_json::from_str(after["body"].as_str().unwrap()).unwrap();
+    let sign = after_body["data"]["sign"].as_str().unwrap();
+    assert_eq!(sign.len(), 32);
+    assert!(
+        sign.bytes()
+            .all(|b| b.is_ascii_digit() || (b'A'..=b'F').contains(&b))
+    );
+    after_body["data"]["sign"] = json!("OLD");
+    assert_eq!(after_body, before_body);
+    assert_eq!(finalize::downstream(&output).unwrap(), output);
+}
+
+#[test]
+fn business_inapplicability_returns_the_entire_input_exactly() {
+    let valid = envelope(&response().to_string());
+    let alterations = [
+        ("method", json!("GET")),
+        ("code", json!(400)),
+        ("code", json!(null)),
+        ("url", json!("/unknown/TOKEN")),
+        ("url", json!("/gateway/pay/version=1.0/B01/1/0/")),
+        ("url", json!("/gateway/pay/version=1.0/B01/1/0/%zz")),
+        ("body", json!("")),
+        ("body", json!("<html>bad gateway</html>")),
+        ("body", json!("{}")),
+        ("body", json!("{\"data\":{\"sign\":\"\"}}")),
+        ("body", json!("{\"data\":{\"sign\":null}}")),
+        ("body", json!("{\"data\":{\"sign\":\"OLD\",\"result\":[]}}")),
+        (
+            "body",
+            json!("{\"data\":{\"sign\":\"OLD\",\"result\":{\"amount\":1.2}}}"),
+        ),
+    ];
+    for (field, replacement) in alterations {
+        let mut value = valid.clone();
+        value[field] = replacement;
+        let input = format!(" \n{}\n", value);
+        assert_eq!(finalize::downstream(&input).unwrap(), input);
+    }
+}
+
+#[test]
+fn raw_body_and_html_are_safe_and_round_trip() {
+    for input in ["", "not JSON", "<script>alert('x')&</script>"] {
+        let decoded = codec::decode(input).unwrap();
+        assert_eq!(
+            serde_json::from_str::<Value>(&decoded).unwrap(),
+            json!(input)
+        );
+        assert_eq!(codec::encode(input, &decoded).unwrap(), input);
+        let html = codec::display(&decoded).unwrap();
+        assert!(!html.contains("<script>"));
+    }
+    let doc = json!({"<img onerror='bad'>":"<script>&\"'"}).to_string();
+    let display = codec::display(&doc).unwrap();
+    assert!(display.contains("&lt;img"));
+    assert!(!display.contains("<img"));
+    assert!(codec::display("invalid Document").is_err());
+    assert!(codec::encode("{}", "invalid Document").is_err());
+}
+
+#[test]
+fn malformed_http_wrapper_is_an_execution_error() {
+    for input in ["not JSON", "{}", "[]"] {
+        assert!(finalize::downstream(input).is_err());
+    }
+    let mut missing = envelope("{}");
+    missing.as_object_mut().unwrap().remove("code");
+    assert!(finalize::downstream(&missing.to_string()).is_err());
+    let mut bad_header = envelope("{}");
+    bad_header["header"]["bad"] = json!(["a", "b"]);
+    assert!(finalize::downstream(&bad_header.to_string()).is_err());
+}
+
+#[test]
+fn every_source_route_retains_raw_token_and_decodes_percent_once() {
+    for (op, names, version) in [
+        (
+            Operation::Pay,
+            [
+                "stub-products-pointPay",
+                "products-pointPay",
+                "stubPay",
+                "pay",
+            ],
+            "version=1.0/",
+        ),
+        (
+            Operation::Confirm,
+            [
+                "stub-products-pointConfirm",
+                "products-pointConfirm",
+                "stubConfirm",
+                "confirm",
+            ],
+            "version=1.0/",
+        ),
+        (
+            Operation::Refund,
+            [
+                "stub-products-refund",
+                "products-refund",
+                "stubRefund",
+                "refund",
+            ],
+            "",
+        ),
+        (
+            Operation::Reverse,
+            [
+                "stub-products-reverse",
+                "products-reverse",
+                "stubReverse",
+                "reverse",
+            ],
+            "",
+        ),
+    ] {
+        for name in names {
+            let path = format!("/base/gateway/{name}/{version}B01/1/0/A%20B+%2520?ignored=yes");
+            assert_eq!(
+                route::operation_and_token(&path),
+                Some((op, "A B+%20".into()))
+            );
+            assert_eq!(
+                route::operation_and_token(&format!("https://cps.example{path}")),
+                Some((op, "A B+%20".into()))
+            );
+        }
+    }
+    assert_eq!(
+        route::operation_and_token("/gateway/pay/version=1.0/B01/1/0/TOKEN/extra"),
+        None
+    );
+    assert_eq!(
+        route::operation_and_token("/gateway/pay/version=1.0/B01/1/0/%FF"),
+        None
+    );
+    assert_eq!(
+        route::operation_and_token(
+            "https://cps.example?redirect=/gateway/pay/version=1.0/B01/1/0/T"
+        ),
+        None
+    );
+}
+
+#[test]
+fn signature_respects_java_model_projection_and_raw_token_padding() {
+    let original = response();
+    let canonical = signing::canonical(&original, Operation::Pay, " TOKEN ").unwrap();
+    assert!(canonical.ends_with("&key=B2B TOKEN }"));
+    assert!(canonical.contains("errorInfo="));
+    assert!(canonical.contains("orderId=order1"));
+    assert!(!canonical.contains("amountRmb="));
+    assert!(!canonical.contains("sign="));
+    assert!(!canonical.contains("extension="));
+    let mut changed = original.clone();
+    changed["data"]["result"]["amount"] = json!("100.0");
+    assert_eq!(
+        signing::signature(&original, Operation::Pay, "T"),
+        signing::signature(&changed, Operation::Pay, "T")
+    );
+    assert_ne!(
+        signing::signature(&original, Operation::Pay, "T"),
+        signing::signature(&original, Operation::Pay, "T ")
+    );
+}

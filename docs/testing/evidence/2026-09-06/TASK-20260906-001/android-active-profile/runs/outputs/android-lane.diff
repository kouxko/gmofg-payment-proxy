+        .weak_network
+        .random_loss_basis_points = 10_000;
+
+    let endpoints = adapter
+        .network_runtime_endpoints(
+            AndroidDeviceTarget {
+                serial: owner.serial,
+            },
+            Some(saved_activation),
+        )
+        .await
+        .unwrap();
+
+    assert!(runner.requests.lock().unwrap().is_empty());

+        wire_body: b"wire".to_vec(),
+    };
+    let socket = SocketContext {
+        data: b"wire".to_vec(),
+    };
+    for projection in ["http", "socket", "without_context"] {
+        let context_bytes = match projection {
+            "http" => http.header.len() + http.body.len(),
+            "socket" => socket.data.len() * 2,

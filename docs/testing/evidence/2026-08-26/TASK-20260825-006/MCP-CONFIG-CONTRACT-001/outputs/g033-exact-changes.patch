+use serde::{Deserialize, Serialize};
+
+#[derive(Clone, Debug, Deserialize, PartialEq, Serialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct EnvironmentMaterials {
+    certificates: Vec<CertificateMaterialInput>,
